{
  "name": "leadsy",
  "version": "0.1.0",
  "private": true,
  "description": "Leadsy AI Lead Capture, Qualification & Conversion Platform for source intake, AI qualification, follow-up, and human-approved outreach.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @leadsy/web run dev",
    "build": "npm --workspace @leadsy/web run build",
    "lint": "npm --workspace @leadsy/web run lint",
    "typecheck": "npm --workspace @leadsy/web run typecheck",
    "test": "npm run test:data-dir && npm run test:lead-knowledge && npm run test:qualification-engine && npm run test:lead-magnet-archive && npm run test:lead-tasks && npm run test:extension-store && npm run test:extension-drafts && npm run test:extension-approval && npm run test:dummy-cleanup && npm run test:pre-twilio-reset && npm run test:full-product-reset && npm run test:extension-retirement && npm run test:twilio-integration && npm run test:twilio-simulator && npm run test:twilio-settings && npm run test:assignment-task-inbox && npm run test:extension-download && npm run test:meta-oauth && npm run test:meta-whatsapp && npm run test:meta-routing && npm run test:google-workspace-auth && npm run test:demo-seed && npm run test:lead-magnet && npm run test:preserved-integrations && npm run test:n8n-workflows && npm run test:automation-gateway && npm run test:openrouter-cost && npm run test:auth-page-surface && npm run test:global-components && npm run test:ux-rules && npm run test:phase-one-routes && npm run test:production-bug-sweep && npm run test:onboarding-options && npm run test:onboarding-surface && npm run test:meta-login-surface && npm run test:whatsapp-crm-v1 && npm run test:user-facing-surface && npm run test:crm-truth-stabilization",
    "test:lead-magnet": "tsx scripts/lead-magnet-agent-tools.test.ts && node scripts/lead-magnet-regression.mjs",
    "test:lead-knowledge": "tsx scripts/lead-knowledge-store.test.ts",
    "test:lead-magnet-archive": "tsx scripts/lead-magnet-archive.test.ts",
    "test:extension-approval": "tsx scripts/extension-app-only-approval.test.ts",
    "test:dummy-cleanup": "tsx scripts/dummy-data-cleanup.test.ts",
    "test:pre-twilio-reset": "tsx scripts/pre-twilio-reset.test.ts",
    "test:full-product-reset": "tsx scripts/full-product-reset.test.ts",
    "test:extension-retirement": "tsx scripts/extension-retirement-surface.test.ts",
    "test:twilio-integration": "tsx scripts/twilio-integration.test.ts",
    "test:twilio-simulator": "tsx scripts/twilio-simulator.test.ts",
    "test:twilio-settings": "tsx scripts/twilio-settings-surface.test.ts",
    "test:assignment-task-inbox": "tsx scripts/assignment-task-inbox.test.ts",
    "test:extension-drafts": "tsx scripts/extension-task-drafts.test.ts",
    "test:demo-seed": "tsx scripts/demo-workspace-seed.test.ts",
    "test:data-dir": "tsx scripts/data-dir.test.ts",
    "test:lead-tasks": "tsx scripts/lead-task-filter.test.ts",
    "test:extension-store": "tsx scripts/extension-store.test.ts",
    "test:meta-oauth": "tsx scripts/meta-oauth-callback.test.ts",
    "test:meta-whatsapp": "tsx scripts/meta-whatsapp-webhook.test.ts",
    "test:meta-routing": "tsx --tsconfig apps/web/tsconfig.json scripts/meta-webhook-routing.test.ts",
    "test:preserved-integrations": "tsx scripts/preserved-integrations.test.ts",
    "test:n8n-workflows": "tsx scripts/n8n-workflows.test.ts",
    "test:automation-gateway": "NODE_OPTIONS='--conditions=react-server' tsx --tsconfig apps/web/tsconfig.json scripts/automation-gateway.test.ts",
    "test:openrouter-cost": "tsx scripts/openrouter-cost-constraints.test.ts",
    "test:auth-page-surface": "tsx scripts/auth-page-surface.test.ts",
    "test:global-components": "tsx scripts/global-components-surface.test.ts",
    "test:ux-rules": "tsx scripts/ux-rules-surface.test.ts",
    "test:phase-one-routes": "tsx scripts/phase-one-route-surface.test.ts",
    "test:production-bug-sweep": "tsx scripts/production-bug-sweep-surface.test.ts",
    "test:onboarding-options": "tsx scripts/onboarding-options-sanitization.test.ts",
    "test:onboarding-surface": "tsx scripts/onboarding-surface.test.ts",
    "test:meta-login-surface": "tsx scripts/meta-login-surface.test.ts",
    "test:extension-download": "tsx scripts/extension-download-page.test.ts",
    "test:user-facing-surface": "tsx scripts/user-facing-surface.test.ts",
    "test:qualification-engine": "tsx scripts/qualification-engine.test.ts",
    "test:crm-truth-stabilization": "tsx scripts/crm-truth-stabilization.test.ts",
    "test:google-workspace-auth": "NODE_OPTIONS='--conditions=react-server' tsx scripts/google-workspace-auth.test.ts",
    "seed": "npm --workspace @leadsy/db run seed",
    "seed:demo": "tsx scripts/seed-demo-workspace.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "workflows:export-n8n": "tsx scripts/export-n8n-workflows.ts",
    "data:backup:pre-twilio-reset": "tsx scripts/export-pre-twilio-reset.ts",
    "data:reset:twilio-crm": "tsx scripts/reset-clean-crm.ts",
    "data:reset:full-product": "tsx scripts/reset-full-product-data.ts",
    "docs": "node -e \"console.log('Architecture docs live in ./docs')\"",
    "test:whatsapp-crm-v1": "tsx scripts/whatsapp-crm-qualification-v1.test.ts"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
