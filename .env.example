# Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local
LEADSY_DATA_DIR=./data/app

# Database - PostgreSQL, not Firebase/Supabase.
DATABASE_URL=postgresql://leadsy:leadsy@localhost:5432/leadsy?schema=public
DATABASE_READ_REPLICA_URL=

# Auth and session cryptography
AUTH_SECRET=replace-with-32-byte-secret
SESSION_COOKIE_NAME=leadsy_session

# AI provider gateway. Leave empty to use the deterministic local provider.
AI_PROVIDER=deterministic
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=openai/gpt-5.2
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_RESEARCH_MODEL=openai/gpt-5.2
OPENROUTER_DOSSIER_MODEL=openai/gpt-5.2
OPENROUTER_SENTIMENT_MODEL=
OPENROUTER_FAST_MODEL=openai/gpt-5.2
LEADSY_SPEND_CAP_INR=1
LEADSY_AI_PLANNER_ENABLED=false

# Queues, cache, realtime
REDIS_URL=redis://localhost:6379
EVENT_BUS_DRIVER=in-memory
QUEUE_DRIVER=in-memory
WEBSOCKET_URL=ws://localhost:3001
BROWSER_WORKER_PROVIDER=local-fetch

# Outreach integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_LEAD_ADS_PAGE_ACCESS_TOKEN=
LINKEDIN_CONNECTOR_WEBHOOK_URL=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Lead Magnet discovery connectors
LEAD_DISCOVERY_DAILY_LIMIT=250
OUTBOUND_REQUIRE_APPROVED_SOURCE=true
LEADSY_RESEARCH_USER_AGENT=LeadsyResearchBot/0.2 (+public business OSINT; manual review; contact configured by operator)
LEADSY_RESEARCH_MIN_DELAY_MS=1500
LEADSY_RESEARCH_DOMAIN_COOLDOWN_MS=30000
LEADSY_RESEARCH_MAX_PAGES_PER_DOMAIN=2
LEADSY_RESEARCH_BATCH_SIZE=75
LEADSY_RESEARCH_ROBOTS_TTL_MS=86400000
LEADSY_RESEARCH_RETRY_AFTER_MAX_MS=120000
LEADSY_RESEARCH_FETCH_CACHE_TTL_MS=900000
LEADSY_SEARCH_API_URL=
LEADSY_SEARCH_API_KEY=
LEADSY_SEARCH_QUERY_PARAM=q
LEADSY_SEARCH_LIMIT_PARAM=count
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Observability and compliance
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
AUDIT_LOG_SINK=stdout
