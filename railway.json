{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=@leadsy/web",
    "watchPatterns": [
      "/apps/web/**",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/web && exec ./node_modules/.bin/next start -H 0.0.0.0 -p ${PORT:-3000}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
