{
  "name": "Leadsy - Task Generated",
  "active": false,
  "nodes": [
    {
      "id": "leadsy-task-generated-webhook-trigger",
      "name": "Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "leadsy/task-generated",
        "responseMode": "responseNode",
        "options": {}
      },
      "notes": "Leadsy creates an extension, CRM, or follow-up task.",
      "notesInFlow": true
    },
    {
      "id": "leadsy-task-generated-normalize",
      "name": "Normalize Execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nreturn [{\n  json: {\n    workflowKey: \"task-generated\",\n    workflowName: \"Task Generated\",\n    triggerId: body.triggerId ?? body.idempotencyKey ?? $execution.id,\n    idempotencyKey: body.idempotencyKey ?? $execution.id,\n    tenantId: body.tenantId,\n    ownerId: body.ownerId,\n    leadId: body.leadId,\n    taskId: body.taskId,\n    conversationId: body.conversationId,\n    startedAt: new Date().toISOString(),\n    payload: body\n  }\n}];"
      },
      "notes": "Normalize webhook/schedule input into the shared Leadsy execution metadata shape.",
      "notesInFlow": true
    },
    {
      "id": "leadsy-task-generated-log-started",
      "name": "Log Started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 60000,
      "continueOnFail": false,
      "parameters": {
        "method": "POST",
        "url": "={{$env.LEADSY_API_BASE_URL + '/api/automation/executions'}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "{\"workflowKey\":\"={{$json.workflowKey}}\",\"n8nExecutionId\":\"={{$execution.id}}\",\"status\":\"started\",\"metadata\":\"={{$json}}\"}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "leadsy-task-generated-run-action",
      "name": "Run Leadsy Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 60000,
      "continueOnFail": false,
      "parameters": {
        "method": "POST",
        "url": "={{$env.LEADSY_API_BASE_URL + '/api/automation/events/task-generated'}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "{\"workflowKey\":\"={{$json.workflowKey}}\",\"n8nExecutionId\":\"={{$execution.id}}\",\"idempotencyKey\":\"={{$json.idempotencyKey}}\",\"payload\":\"={{$json.payload}}\"}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "leadsy-task-generated-log-succeeded",
      "name": "Log Succeeded",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 60000,
      "continueOnFail": false,
      "parameters": {
        "method": "POST",
        "url": "={{$env.LEADSY_API_BASE_URL + '/api/automation/executions'}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "{\"workflowKey\":\"={{$json.workflowKey}}\",\"n8nExecutionId\":\"={{$execution.id}}\",\"status\":\"succeeded\",\"metadata\":\"={{$json}}\"}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "leadsy-task-generated-log-failed",
      "name": "Log Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        180
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 60000,
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "={{$env.LEADSY_API_BASE_URL + '/api/automation/executions'}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "{\"workflowKey\":\"={{$json.workflowKey}}\",\"n8nExecutionId\":\"={{$execution.id}}\",\"status\":\"failed\",\"metadata\":\"={{$json}}\"}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "leadsy-task-generated-response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, workflowKey: $json.workflowKey, executionId: $execution.id } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Normalize Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Execution": {
      "main": [
        [
          {
            "node": "Log Started",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Started": {
      "main": [
        [
          {
            "node": "Run Leadsy Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Leadsy Action": {
      "main": [
        [
          {
            "node": "Log Succeeded",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Succeeded": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Failed": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "meta": {
    "leadsyWorkflowKey": "task-generated",
    "purpose": "Route approvals, due reminders, and retry schedules around Leadsy task state.",
    "preserves": "Task CRUD and status transitions stay in Leadsy."
  }
}
