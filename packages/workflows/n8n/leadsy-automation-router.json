{
  "name": "Leadsy - Automation Router",
  "active": false,
  "nodes": [
    {
      "id": "leadsy-router-webhook-trigger",
      "name": "Leadsy Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "leadsy/automation-router",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 202,
          "responseData": "firstEntryJson"
        }
      },
      "notes": "Single Leadsy entrypoint. Send { workflowKey, tenantId, ownerId, idempotencyKey, payload } to route automation events.",
      "notesInFlow": true
    },
    {
      "id": "leadsy-router-follow-up-schedule",
      "name": "Follow-up Due Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "notes": "Follow-up Due Schedule feeds the same router canvas as external Leadsy events.",
      "notesInFlow": true
    },
    {
      "id": "leadsy-router-worker-retry-schedule",
      "name": "Worker Retry Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        440
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "notes": "Worker Retry Schedule feeds the same router canvas as external Leadsy events.",
      "notesInFlow": true
    },
    {
      "id": "leadsy-router-normalize-webhook",
      "name": "Normalize Webhook Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst workflowKey = body.workflowKey ?? body.leadsyWorkflowKey ?? body.eventType ?? body.type;\nreturn [{\n  json: {\n    workflowKey,\n    workflowName: workflowKey,\n    triggerId: body.triggerId ?? body.idempotencyKey ?? $execution.id,\n    idempotencyKey: body.idempotencyKey ?? $execution.id,\n    tenantId: body.tenantId,\n    ownerId: body.ownerId,\n    leadId: body.leadId,\n    taskId: body.taskId,\n    conversationId: body.conversationId,\n    startedAt: new Date().toISOString(),\n    payload: body.payload ?? body\n  }\n}];"
      },
      "notes": "Normalizes event payloads emitted by Leadsy APIs.",
      "notesInFlow": true
    },
    {
      "id": "leadsy-router-normalize-follow-up-due",
      "name": "Normalize Follow-up Due",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        220
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    workflowKey: \"follow-up-due\",\n    workflowName: \"Follow-up Due\",\n    triggerId: $execution.id,\n    idempotencyKey: $execution.id,\n    startedAt: new Date().toISOString(),\n    payload: {\n      scheduled: true,\n      dueWindowMinutes: 15,\n      triggeredAt: new Date().toISOString()\n    }\n  }\n}];"
      },
      "notes": "n8n scheduled due check or task due timestamp.",
      "notesInFlow": true
    },
    {
      "id": "leadsy-router-normalize-worker-retry",
      "name": "Normalize Worker Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        440
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    workflowKey: \"worker-retry\",\n    workflowName: \"Worker Retry\",\n    triggerId: $execution.id,\n    idempotencyKey: $execution.id,\n    startedAt: new Date().toISOString(),\n    payload: {\n      scheduled: true,\n      dueWindowMinutes: 5,\n      triggeredAt: new Date().toISOString()\n    }\n  }\n}];"
      },
      "notes": "Worker task failed, blocked, postponed, or reached retry due time.",
      "notesInFlow": true
    },
